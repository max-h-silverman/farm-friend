.idea/

# Agent worktrees — scratch checkouts, never part of the repository.
.claude/worktrees/

# Mail captured by EMAIL_PROVIDER=simulator during local development. Holds live
# verification codes and farmer email addresses, so it must never be committed.
.mail/

# Terraform / OpenTofu working state. Provider plugins are large and machine-specific;
# state and plan files can contain resource metadata and must never be committed.
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
infra/terraform.tfvars

# Python bytecode from the infra assertion scripts
__pycache__/
*.pyc

# Screenshots max drops in the repo root to show a defect. Working material, not source.
/*.png

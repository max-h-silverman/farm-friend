{
  "name": "farm-friend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/ai",
    "packages/core",
    "packages/db",
    "packages/sms"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck:packages && npm run typecheck:web",
    "typecheck:packages": "tsc -b",
    "typecheck:web": "npm run typecheck --workspace @farm-friend/web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:seed": "tsx packages/db/scripts/seed-stands.ts",
    "db:seed-offerings": "tsx packages/db/scripts/seed-offerings.ts",
    "offerings:propose": "node --env-file=.env --import tsx packages/ai/scripts/propose-offerings.ts",
    "evals": "node --import tsx evals/run.ts",
    "evals:live": "node --env-file=.env --import tsx evals/live.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}

# Farm Friend — local environment template (GL-033).
#
# Copy to `.env` and fill. `.env` is gitignored; this file is committed and MUST NEVER
# contain a real credential — not a database URL, not an API key, not a salt.
#
# Configuration FAILS CLOSED in the single composition root (apps/web/lib/composition.ts):
# a missing or blank required value is a startup error, never a silent default. That is
# deliberate and has already caught a real production defect (GL-019, below).

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection, used by the app, the migrations, and the integration suite.
# The integration suite creates and drops its own throwaway databases, so this should
# point at a local server you are willing to let it do that on.
DATABASE_URL="postgres://localhost:5432/farmfriend"

# ---------------------------------------------------------------------------
# Privacy and authority secrets — generate real values, e.g. `openssl rand -base64 32`
# ---------------------------------------------------------------------------

# The phone hash is the ONLY lookup/log key in the system.
#
# RECORD IT IN A PASSWORD MANAGER THE MOMENT YOU SET IT. This is the instruction that
# actually matters, and it was not followed: the production salt was set in Vercel marked
# "Sensitive", which is WRITE-ONLY — `vercel env ls` shows "Encrypted" and `vercel env pull`
# returns `[SENSITIVE]`. The value existed in exactly one place nobody could read, and was
# lost (2026-07-29). Setting a secret somewhere unreadable is the same as not recording it.
#
# NEVER ROTATE THIS ONCE REAL DATA EXISTS — with one precise exception, worth stating because
# the absolute version of this rule caused a moment of unnecessary alarm. Changing the salt
# orphans every phone hash: consent records, contacts, flags, and stock-out reports stop
# resolving to their people, and a hash cannot be reversed.
#
# The exception: while `contacts.phone_e164` still holds the RAW number, every hash can be
# recomputed from it, so a new salt can be applied by a re-hash migration
# (`npm run db:rehash-phones`, proven against a real foreign-key graph). That window closes
# on its own — the raw number is the only thing that makes recovery possible, so once a
# contact is purged there is no way back for that person's rows.
#
# So: the salt is recoverable-by-migration while raw numbers exist, and unrecoverable after.
# Do not rely on the window. Record the value.
PHONE_HASH_SALT="replace-me-with-a-generated-secret"

# NOTE: `CRON_SECRET` is GONE. The scheduled-worker route no longer takes a shared secret.
# It is worker-only (DEPLOYMENT_ROLE below) and reached solely through Cloud Scheduler's OIDC
# identity against an internal-ingress Cloud Run service with IAM `run.invoker`. The secret
# was removed rather than kept alongside IAM because it lived in two places that had to match
# — the platform env var and a GitHub repository secret — where a mismatch produced a 401 that
# looks identical to success in a scheduler's UI, and rotating one side silently stopped every
# scheduled pass.

# Signs administrator sign-in links. A guessable value forges authority over the admin
# surface, so the callback refuses to verify rather than trust a default.
MAGIC_LINK_SECRET="replace-me-with-a-generated-secret"

# The public origin sign-in links are built against. Must be absolute; `http` is refused
# outside localhost because a sign-in link is a bearer credential. Deliberately
# configuration rather than derived from the request `Host:` header, which an attacker
# controls.
PUBLIC_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Model provider — REQUIRED, no default (GL-019)
# ---------------------------------------------------------------------------

# `stub` (deterministic test double, no network call) or `deepinfra`.
#
# There is no default and no environment sniffing. Until 2026-07-28 this defaulted to
# `stub` and production had never set it, so the live deployment ran the test double
# against real traffic while every health check and suite stayed green. Requiring it
# everywhere — rather than "in production only" — is the point: a rule that relaxes
# off-production behaves one way everywhere it is tested and another way where it matters.
#
# `stub` is the right choice for ordinary local work. It just has to be asked for.
LLM_PROVIDER="stub"

# Required only when LLM_PROVIDER=deepinfra. An `anthropic/`- or `google/`-namespaced model
# is refused at startup: those route to a third-party vendor whose data-handling terms were
# never attested, which would make the version-controlled attestation false.
# DEEPINFRA_API_KEY=""
# DEEPINFRA_MODEL="mistralai/Mistral-Small-24B-Instruct-2501"

# ---------------------------------------------------------------------------
# SMS provider
# ---------------------------------------------------------------------------

# `simulator` or `telnyx`. No default; unset or unknown is a configuration error.
SMS_PROVIDER="simulator"

# Required when SMS_PROVIDER=telnyx — all four, or startup fails.
# TELNYX_PUBLIC_KEY is the ed25519 WEBHOOK VERIFICATION key; without it inbound webhooks
# cannot be verified at all. It is verification material rather than a secret.
# TELNYX_API_KEY=""
# TELNYX_MESSAGING_PROFILE_ID=""
# TELNYX_FROM_NUMBER="+12065550000"
# TELNYX_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# Deployment role and the immediate-work queue (Cloud Run)
# ---------------------------------------------------------------------------

# `web` (public ingress) or `worker` (internal ingress + IAM). ONE container image runs as
# both services, pinned to the same digest, so the two can never drift apart.
#
# Absent means `web`, which is deliberate and the opposite of this file's usual fail-closed
# default. The dangerous misconfiguration is a deployment that exposes INTERNAL routes, not
# one that exposes public routes — so a missing value yields the surface that refuses
# `/api/internal/*`. A MISSPELLED value is still a startup error.
# DEPLOYMENT_ROLE="worker"

# The Cloud Tasks queue that replaced Vercel's `waitUntil` — the durable fast path from "a
# message arrived" to "the reply is sent".
#
# ALL FIVE OR NONE. A partial configuration is a startup error, because it would otherwise
# look configured, construct without complaint, and fail every enqueue at runtime — leaving
# the deployment silently dependent on the once-a-minute scheduled pass while an operator
# believes the fast path is live. Absent entirely is the legitimate "no queue here" case that
# local development and the test suites use; the scheduled pass still does all the work, just
# not within seconds.
# CLOUD_TASKS_PROJECT="farm-friend-vashon"
# CLOUD_TASKS_LOCATION="us-west1"
# CLOUD_TASKS_QUEUE="inbound-work"
# CLOUD_TASKS_TARGET_URL="https://farm-friend-worker-xxxx-uw.a.run.app/api/internal/kick"
# CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT="farm-friend-invoker@farm-friend-vashon.iam.gserviceaccount.com"

# ---------------------------------------------------------------------------
# Deliberately unconfigured
# ---------------------------------------------------------------------------
#
# MAIL — there is no mail provider and no variable for one yet (F-031). The sign-in request
# path is built against a `MailSender` seam whose only implementation FAILS CLOSED: an
# attempted send throws rather than quietly succeeding. Until a provider is chosen and its
# data handling attested, an administrator requesting a link gets the same response as
# everyone else and no mail is delivered; a link must be minted out of band with
# `issueMagicToken`.

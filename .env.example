# Farm Friend — environment (copy to .env; .env is gitignored)

# Postgres / Neon — required for migrations + integration tests
DATABASE_URL=postgres://user:pass@localhost:5432/farmfriend

# LLM provider — "stub" (default, used by tests/evals) or "deepinfra". An unknown value is a
# configuration error, never a silent fallback to the stub.
#
# DeepInfra's data-handling terms are attested in apps/web/lib/composition.ts
# (DEEPINFRA_DATA_HANDLING, reviewed 2026-07-28 — F-024). The attestation excludes models
# DeepInfra routes to a third-party vendor: an "anthropic/" or "google/" DEEPINFRA_MODEL is
# refused at startup, because those requests transfer data under that vendor's unattested
# terms. Choose a DeepInfra-hosted open-weight instruct model.
LLM_PROVIDER=stub
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=

# SMS provider — "simulator" or "telnyx". No default: an unset or unknown value is a
# configuration error, not a silent fallback. With "telnyx" all four below are required.
SMS_PROVIDER=simulator
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=
# ed25519 webhook verification key from the Telnyx portal. Without it inbound
# webhooks cannot be verified, so live SMS fails configuration at startup.
TELNYX_PUBLIC_KEY=

# Privacy — salt for phone hashing (never commit a real value)
PHONE_HASH_SALT=dev-only-change-me

# Scheduled workers — shared secret for POST/GET /api/internal/cron (F-023). Required with
# no default and no local-only bypass: the workers apply consent transitions and send SMS,
# so an unauthenticated trigger is a remote way to drive real messaging.
CRON_SECRET=dev-only-change-me

# Admin auth — signs the email magic links that establish an operator session (F-025a).
# Required with no default: the callback returns 503 rather than verifying signatures against
# a guessable value, which would be an open door to the farm-approval surface.
# The first administrator per environment comes from the bootstrap script — see
# docs/RUNBOOK.md "Bootstrap the first administrator".
MAGIC_LINK_SECRET=dev-only-change-me

# The public origin sign-in links are built against (F-032). Required with no default, and
# validated: it must be an absolute URL, and http is refused outside localhost because a
# sign-in link is a bearer credential that must not travel in cleartext. Configured rather
# than derived from the request, so an attacker-controlled Host header cannot make Farm
# Friend mail an operator a link pointing at the attacker's origin.
PUBLIC_BASE_URL=http://localhost:3000

# Mail provider — NOT YET CONFIGURED (F-031). The sign-in request path is built against a
# MailSender seam whose only implementation fails closed: an attempted send throws rather
# than silently succeeding. Choosing a vendor requires reading its data-processing terms and
# recording the attestation — never inferring it. Until then, no sign-in link is delivered.

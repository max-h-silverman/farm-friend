# Farm Friend — environment (copy to .env; .env is gitignored)

# Postgres / Neon — required for migrations + integration tests
DATABASE_URL=postgres://user:pass@localhost:5432/farmfriend

# LLM provider — "stub" (default in tests/evals) or "openweight"
LLM_PROVIDER=stub
LLM_MODEL=

# SMS provider — "simulator" or "telnyx". No default: an unset or unknown value is a
# configuration error, not a silent fallback. With "telnyx" all four below are required.
SMS_PROVIDER=simulator
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=
# ed25519 webhook verification key from the Telnyx portal. Without it inbound
# webhooks cannot be verified, so live SMS fails configuration at startup.
TELNYX_PUBLIC_KEY=

# Privacy — salt for phone hashing (never commit a real value)
PHONE_HASH_SALT=dev-only-change-me

# Scheduled workers — shared secret for POST/GET /api/internal/cron (F-023). Required with
# no default and no local-only bypass: the workers apply consent transitions and send SMS,
# so an unauthenticated trigger is a remote way to drive real messaging.
CRON_SECRET=dev-only-change-me

# Auth — email magic links (F-006c)
MAGIC_LINK_SECRET=dev-only-change-me
